# Resume Screening Agent — environment variables
# Copy to .env and fill in secrets. OpenAI is required from Phase 3 onward.

# Required from Phase 3 (parsing/scoring). Leave empty in Phase 1.
OPENAI_API_KEY=

# Optional. If set and PARSE_MODEL is unset, parse_model defaults to Claude Sonnet.
# Scoring always stays on SCORE_MODEL (GPT-4o by default).
ANTHROPIC_API_KEY=

# Optional LangSmith tracing.
LANGSMITH_API_KEY=

# LLM / embedding models
PARSE_MODEL=gpt-4o
SCORE_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Routing: auto-persist Strong Match / Not Relevant only when confidence >= this value.
CONFIDENCE_THRESHOLD=0.7

# Persistence and retrieval
CHROMA_DIR=data/chroma
SQLITE_PATH=data/tracking.db
TOP_K=5

# Optional. Set to local to force token-hash embeddings even if OPENAI_API_KEY is set.
# RESUME_SCREENER_EMBEDDINGS=local
